# Copy to .env for local development. Never commit .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# sqlite is the local default. For Postgres:
# DATABASE_URL=postgres://movienight:movienight@localhost:5432/movienight
DATABASE_URL=sqlite:///db.sqlite3

# PhonePe Standard Checkout (salt + X-VERIFY). Leave mock on until sandbox keys are set.
PHONEPE_MOCK=True
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_REDIRECT_URL=http://127.0.0.1:8000/payments/return/
PHONEPE_CALLBACK_URL=http://127.0.0.1:8000/payments/callback/

# ID card storage. Local media/ is used when both are empty (dev only).
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_PUBLIC_URL=
AWS_S3_REGION=auto
